{
  "layers": [
    {"name": "core", "paths": ["src/core/**"]},
    {"name": "render", "paths": ["src/render/**"]},
    {"name": "web", "paths": ["src/web/**"]},
    {"name": "server", "paths": ["src/app.ts", "src/app.test.ts", "src/server.ts"]}
  ],
  "allow": {
    "render": ["core"],
    "web": ["core", "render"]
  }
}
